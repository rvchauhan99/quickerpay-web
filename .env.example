QP_DEPLOYMENT_MODE=MULTI_TENANT
QP_ROOT_DOMAIN=quickerpay.local
QP_WEB_PORT=3000
QP_API_ORIGIN=http://127.0.0.1:4000

# local | development | testing | production
# Pay-In/Pay-Out Create and /mock/gpay only when this is a lab value AND NODE_ENV is not
# production. On Vercel production set NEXT_PUBLIC_QP_ENV=production (lab is also forced
# off whenever NODE_ENV=production, even if this was left as local).
NEXT_PUBLIC_QP_ENV=local

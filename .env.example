QP_DEPLOYMENT_MODE=MULTI_TENANT
QP_ROOT_DOMAIN=quickerpay.local
QP_WEB_PORT=3000
QP_API_ORIGIN=http://127.0.0.1:4000

# local | development | testing | test | production
# Pay-In/Pay-Out Create only when this is a lab value AND NODE_ENV is not production.
# /mock/gpay is allowed for local and test even on a production Next build (the test
# host). It is never served when this is production or prod, or when it is unset on
# a production build. On production set NEXT_PUBLIC_QP_ENV=production.
NEXT_PUBLIC_QP_ENV=local

# Product display name in UI chrome (sidebar, login, document title). Default SafePay247.
NEXT_PUBLIC_QP_BRAND_NAME=SafePay247
